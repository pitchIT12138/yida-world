{
  "name": "yida-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "collector": "tsx collector/serve.ts",
    "collector:install": "playwright install chromium --no-shell",
    "collector:login": "COLLECTOR_HEADED=true tsx collector/serve.ts --login",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:collector": "tsx tests/collector.integration.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "benchmark": "tsx scripts/benchmark.ts",
    "curate": "tsx scripts/curate.ts",
    "promote": "tsx scripts/promote.ts",
    "baselines": "tsx scripts/sync-baselines.ts",
    "test:manual-browser": "tsx tests/manual-browser.integration.ts",
    "test:manual-ui": "tsx tests/manual-browser-ui.integration.ts",
    "test:qr-import": "tsx tests/qr-import.integration.ts",
    "test:paste-import": "tsx tests/paste-import.integration.ts",
    "test:workspace-ui": "tsx tests/workspace-ui.integration.ts",
    "test:session-v3": "tsx tests/session-v3.integration.ts",
    "studio": "tsx scripts/studio.ts",
    "test:studio": "tsx tests/studio.integration.ts",
    "library": "tsx scripts/library.ts",
    "test:rebuild": "tsx tests/rebuild.integration.ts",
    "test:curated-reading": "tsx tests/curated-reading.integration.ts"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "parse5": "^8.0.1",
    "playwright": "^1.63.0",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.7",
    "jsdom": "^27.0.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
